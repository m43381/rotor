{
  "openapi": "3.1.0",
  "info": {
    "title": "DutyFlow analytics",
    "version": "0.1.0"
  },
  "paths": {
    "/metrics/overview": {
      "get": {
        "tags": [
          "metrics"
        ],
        "summary": "Нагрузка и справедливость по поддереву за период: сводка для дашборда",
        "operationId": "overview_metrics_overview_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "unit_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Подразделение; учитывается всё поддерево",
              "title": "Unit Id"
            },
            "description": "Подразделение; учитывается всё поддерево"
          },
          {
            "name": "date_from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "Первая дата заступления",
              "title": "Date From"
            },
            "description": "Первая дата заступления"
          },
          {
            "name": "date_to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "Последняя дата заступления",
              "title": "Date To"
            },
            "description": "Последняя дата заступления"
          },
          {
            "name": "drafts",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Учитывать черновики графиков (№57)",
              "default": false,
              "title": "Drafts"
            },
            "description": "Учитывать черновики графиков (№57)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Overview"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/metrics/people": {
      "get": {
        "tags": [
          "metrics"
        ],
        "summary": "Нагрузка по людям",
        "operationId": "people_metrics_people_get",
        "security": [
          {
            "HTTPBearer": []
