# Шаблон переменных окружения стенда. Реальный файл — deploy/.env (в git не попадает).
# `./dutyflow.sh init` (или `just env`) создаёт его из этого шаблона и заменяет все CHANGE_ME
# на случайные секреты. Подстановки ${...} разворачивает docker compose.

# --- Адрес сервера и порт: обычно меняются только эти строки ---
# IP или DNS-имя сервера в локальной сети — ровно то, что пользователи вводят в браузере:
# вход перенаправляет на этот адрес, и при несовпадении (localhost ≠ 127.0.0.1) не открывается
SERVER_HOST=localhost
# Внешний порт, по которому пользователи заходят в систему (HTTP). Если он занят —
# поменяйте здесь и выполните `docker compose up -d`: шлюз и Keycloak подстроятся сами.
GATEWAY_PORT=8088
# Адрес, который видит браузер. Собирается из строк выше, вручную менять не нужно.
# Исключение — стандартный порт 80: тогда укажите адрес без порта, `http://${SERVER_HOST}`,
# иначе вход не пройдёт (браузер не пишет :80 в адресе, а Keycloak сравнивает строки).
PUBLIC_URL=http://${SERVER_HOST}:${GATEWAY_PORT}

# Резервные копии (`just backup` / `dutyflow.sh backup`): каталог на хосте и срок хранения
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# Предел памяти воркера распределения
ALLOCATION_WORKER_MEMORY=4g

# --- PostgreSQL: суперпользователь инсталляции и отдельные БД/роли на сервис ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
PERSONNEL_DB_PASSWORD=CHANGE_ME
ORG_DB_PASSWORD=CHANGE_ME
SCHEDULING_DB_PASSWORD=CHANGE_ME
DOCUMENTS_DB_PASSWORD=CHANGE_ME
ANALYTICS_DB_PASSWORD=CHANGE_ME
AUTH_ADMIN_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME

# --- Keycloak ---
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# Пароль первого суперадминистратора DutyFlow (логин: admin). Сменить после первого входа.
DUTYFLOW_ADMIN_PASSWORD=CHANGE_ME
# Секрет служебного клиента auth-admin в Keycloak (управление операторами из интерфейса)
AUTH_ADMIN_CLIENT_SECRET=CHANGE_ME

# --- Межсервисный секрет для /internal/* ---
INTERNAL_TOKEN=CHANGE_ME

# --- Корневое подразделение: этот же id прописан администратору в Keycloak ---
ROOT_UNIT_ID=00000000-0000-7000-8000-000000000001
ROOT_UNIT_NAME=Академия

LOG_LEVEL=INFO
# Часовой пояс инсталляции: начало и конец нарядов считаются в местном времени (ADR-0008)
TIMEZONE=Europe/Moscow
