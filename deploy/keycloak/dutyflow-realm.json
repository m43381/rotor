{
  "realm": "dutyflow",
  "displayName": "DutyFlow",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ru"
  ],
  "defaultLocale": "ru",
  "sslRequired": "none",
  "bruteForceProtected": true,
  "failureFactor": 10,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 43200,
  "passwordPolicy": "length(10)",
  "roles": {
    "realm": [
      {
        "name": "superadmin",
        "description": "Суперадминистратор: всё дерево, справочники, операторы"
      },
      {
        "name": "unit_admin",
        "description": "Администратор подразделения: своё поддерево и его операторы"
      },
      {
        "name": "operator",
        "description": "Оператор: планирование в пределах своего поддерева"
      },
      {
        "name": "viewer",
        "description": "Только просмотр своего поддерева"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "dutyflow",
      "description": "Все claims DutyFlow: sub, логин, ФИО, роли, подразделение, аудитория API. Встроенные scope Keycloak (profile/roles/basic) не используются, чтобы состав токена был явным.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "unit_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "unit_id",
            "claim.name": "unit_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "dutyflow-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "dutyflow-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "dutyflow-spa",
      "name": "DutyFlow (веб-интерфейс)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "${PUBLIC_URL}/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "${PUBLIC_URL}",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${PUBLIC_URL}/*##http://localhost:5173/*"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "dutyflow"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "dutyflow-cli",
      "name": "DutyFlow (скрипты разработчика: seed, бенчмарки)",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "dutyflow"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "firstName": "Администратор",
      "lastName": "Системы",
      "attributes": {
        "unit_id": [
          "${ROOT_UNIT_ID}"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${DUTYFLOW_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "superadmin"
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"unit_id\",\"displayName\":\"Подразделение\",\"validations\":{\"length\":{\"max\":64}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[],\"unmanagedAttributePolicy\":\"ADMIN_VIEW\"}"
          ]
        }
      }
    ]
  }
}
